{
  "name": "ai-canvas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "DB_MODE=json node server/src/index.js",
    "dev:server:pg": "node -e \"if(!process.env.DATABASE_URL){console.error('Missing DATABASE_URL. Example: DATABASE_URL=postgresql://zian@127.0.0.1:5432/xuegao_canvas npm run dev:server:pg'); process.exit(1)}\" && DB_MODE=postgres node server/src/index.js",
    "check:pg": "node server/src/check-pg.js",
    "dev:server:watch": "node --watch server/src/index.js",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:all:pg": "node scripts/dev-all.mjs --pg",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f frontend api postgres",
    "docker:check": "docker compose ps && curl -sS http://127.0.0.1:8787/api/health && curl -sS -I http://127.0.0.1:5173/xuegao-canvas/",
    "admin:check": "node scripts/check-admin.mjs",
    "server": "node server/src/index.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.1",
    "@vue-flow/minimap": "^1.5.4",
    "axios": "^1.13.2",
    "naive-ui": "^2.43.2",
    "pinia": "^3.0.4",
    "pg": "^8.13.1",
    "vue": "^3.5.24",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "vite": "^5.2.0"
  }
}
